<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Add Friends Search -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_add_friends"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:padding="@dimen/spacing_md"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_friend_search"
                style="@style/Widget.OnTheCourt.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_search_friends">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_friend_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_friend_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/btn_search"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_no_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_search_results"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingVertical="@dimen/spacing_md"
            android:visibility="gone"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="@dimen/spacing_sm"/>

        <!-- Friend Requests Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/friend_requests"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:padding="@dimen/spacing_md"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_friend_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tv_no_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_friend_requests"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingVertical="@dimen/spacing_md"
            android:visibility="gone"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="@dimen/spacing_sm"/>

        <!-- My Friends Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_friends"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:padding="@dimen/spacing_md"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_friends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tv_no_friends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_friends"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>